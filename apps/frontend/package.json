{
  "name": "resume-devops-frontend",
  "version": "1.0.0",
  "description": "Modern React frontend for DevOps practice project with monitoring integration",
  "main": "src/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write src/",
    "docker:build": "docker build -t rwxatharv/resume-devops-frontend:latest .",
    "docker:push": "docker push rwxatharv/resume-devops-frontend:latest"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.13.0",
    "@tanstack/react-query": "^4.0.0",
    "axios": "^1.4.0",
    "chart.js": "^4.5.1",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "notistack": "^2.0.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "recharts": "^2.6.2",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.43.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^2.8.8",
    "rollup-plugin-visualizer": "^4.0.0",
    "vite": "^4.4.0",
    "vitest": "^0.32.0"
  }
}
