{
  "name": "resume-devops-backend",
  "version": "1.0.0",
  "description": "Production-ready Node.js backend for DevOps practice platform with monitoring, logging, and API features",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write src/",
    "docker:build": "docker build -t rwxatharv/resume-devops-backend:latest .",
    "docker:push": "docker push rwxatharv/resume-devops-backend:latest",
    "prepare": "husky install || true",
    "precommit": "lint-staged",
    "seed": "node scripts/seedDatabase.js",
    "migrate": "node scripts/runMigrations.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "dotenv": "^16.3.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "rate-limiter-flexible": "^3.0.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.7.0",
    "hpp": "^0.2.3",
    "xss-clean": "^0.1.4",
    "joi": "^17.9.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.10.0",
    "winston-mongodb": "^5.1.1",
    "express-winston": "^4.2.0",
    "socket.io": "^4.7.0",
    "axios": "^1.4.0",
    "node-cron": "^3.0.2",
    "lodash": "^4.17.21",
    "uuid": "^9.0.0",
    "validator": "^13.9.0",
    "sharp": "^0.32.0",
    "multer": "^1.4.5-lts.1",
    "csv-parser": "^3.0.0",
    "json2csv": "^5.0.7",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.0",
    "node-cache": "^5.1.2",
    "async": "^3.2.4",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "redis": "^4.6.0",
    "ioredis": "^5.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.0",
    "supertest": "^6.3.3",
    "eslint": "^8.43.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.0",
    "eslint-plugin-standard": "^5.0.0",
    "prettier": "^2.8.8",
    "husky": "^8.0.0",
    "lint-staged": "^13.2.0",
    "mongodb-memory-server": "^8.12.0",
    "faker": "^6.6.6"
  }
}
